{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sprite Assistant",
  "identifier": "com.sprite.validation",
  "build": {
    "frontendDist": "ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sprite Assistant",
        "width": 300,
        "height": 400,
        "center": true,
        "closable": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "minimizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "visible": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "desktop",
        "panel"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/whisper/*.bin",
      "resources/piper/**/*",
      "resources/sprite_voice_sidecar.exe"
    ]
  },
  "plugins": {
    "globalShortcut": {
      "all": true
    },
    "sprite": {
      "ui": {
        "enablePanel": true,
        "showMainInTaskbar": false
      }
    }
  }
}
