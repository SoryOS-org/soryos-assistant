# Copy this file to `.env` (or `.env.local`) for local development.
# WARNING: Never commit `.env` files with real credentials.

AI_GATEWAY_URL="https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/openrouter/chat/completions"
AI_GATEWAY_TOKEN="replace-with-your-token"
WORKER_AUTH_TOKEN="replace-with-your-shared-worker-token"

# Optional overrides
# AI_GATEWAY_MODEL="mistralai/mistral-small-3.2-24b-instruct:free"
# AI_GATEWAY_PROVIDER="cloudflare_compat"
# AI_GATEWAY_PROVIDER_API_KEY="YOUR_PROVIDER_API_KEY"
# AI_GATEWAY_SYSTEM_PROMPT="Custom prompt with {{PERSONALITY}} token"
# AI_GATEWAY_PERSONALITY="Professional and concise"
